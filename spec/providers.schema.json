{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anydav.local/providers.schema.json",
  "title": "anydav provider registry",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "providers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["id", "name", "category", "auth", "capabilities", "verification"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "nameZh": { "type": "string" },
        "category": {
          "enum": ["consumer", "nas", "self-hosted", "gateway", "generic"]
        },
        "baseUrl": { "type": ["string", "null"] },
        "urlTemplate": { "type": ["string", "null"] },
        "urlHints": { "type": "array", "items": { "type": "string" } },
        "auth": { "$ref": "#/$defs/auth" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "limits": { "$ref": "#/$defs/limits" },
        "quirks": { "$ref": "#/$defs/quirks" },
        "detect": { "$ref": "#/$defs/detect" },
        "docsUrl": { "type": "string" },
        "verification": { "enum": ["live", "documented", "unverified"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "notesZh": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auth": {
      "type": "object",
      "required": ["scheme", "passwordKind"],
      "additionalProperties": true,
      "properties": {
        "scheme": { "enum": ["basic", "digest", "bearer", "none"] },
        "passwordKind": {
          "enum": ["account", "app-password", "webdav-password", "sub-account", "token"]
        },
        "usernameHint": { "type": "string" },
        "passwordHint": { "type": "string" },
        "note": { "type": "string" },
        "noteZh": { "type": "string" },
        "twoFactor": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["quota", "move", "copy", "rangeRead", "etag", "depthInfinity", "chunkedUpload"],
      "additionalProperties": true,
      "properties": {
        "quota": { "type": ["boolean", "null"] },
        "move": { "type": ["boolean", "null"] },
        "copy": { "type": ["boolean", "null"] },
        "rangeRead": { "type": ["boolean", "null"] },
        "etag": { "type": ["boolean", "null"] },
        "depthInfinity": { "type": ["boolean", "null"] },
        "chunkedUpload": { "enum": [false, "nextcloud", null] }
      }
    },
    "limits": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "maxUploadBytes": { "type": "integer", "minimum": 0 },
        "propfindMaxEntries": { "type": "integer", "minimum": 1 },
        "requestsPer30Min": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "free": { "type": "integer", "minimum": 0 },
            "paid": { "type": "integer", "minimum": 0 }
          }
        },
        "note": { "type": "string" },
        "noteZh": { "type": "string" }
      }
    },
    "quirks": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "appPasswordRequired": { "type": "boolean" },
        "putParentMustExist": { "type": "boolean" },
        "mkdirAlreadyExistsStatuses": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "knownIssues": { "type": "array", "items": { "type": "string" } },
        "knownIssuesZh": { "type": "array", "items": { "type": "string" } }
      }
    },
    "detect": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "hosts": { "type": "array", "items": { "type": "string" } },
        "hostSuffixes": { "type": "array", "items": { "type": "string" } },
        "pathIncludes": { "type": "array", "items": { "type": "string" } },
        "ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    }
  }
}
